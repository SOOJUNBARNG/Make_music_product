# infra/gcp.sh の設定。環境変数で個別に上書きもできる (例: ZONE=asia-northeast1-a infra/gcp.sh quota)

PROJECT=jpix-it
ZONE=us-central1-a
# create はこの順にゾーンを試し、L4 の空きが無いゾーンは飛ばす。作れたゾーンは infra/.vm-zone に記録され、以降のコマンドはそれを使う
# jpix-it は全リージョンに Spot L4 の割り当てが 1 ずつある (全体の上限 GPUS_ALL_REGIONS も 1 なので、同時に作れるのは 1 台)
# g2-standard-8 が使える全ゾーンを、おおむね料金の安い順 (米国 → カナダ → 欧州 → アジア) に並べている
ZONE_CANDIDATES="us-central1-a us-central1-b us-central1-c
  us-east1-b us-east1-c us-east1-d us-east4-a us-east4-c
  us-west1-a us-west1-b us-west1-c us-west4-a us-west4-c
  northamerica-northeast1-b northamerica-northeast1-c northamerica-northeast2-a northamerica-northeast2-b
  europe-west4-a europe-west4-b europe-west4-c europe-west1-b europe-west1-c
  europe-west2-a europe-west2-b europe-west3-a europe-west3-b europe-west6-b europe-west6-c
  asia-northeast1-a asia-northeast1-b asia-northeast1-c asia-northeast3-a asia-northeast3-b
  asia-east1-a asia-east1-b asia-east1-c asia-southeast1-a asia-southeast1-b asia-southeast1-c
  asia-south1-a asia-south1-b asia-south1-c me-central2-a me-central2-c"
VM_NAME=makemusic-l4
# g2-standard-8 = 8 vCPU / 32GB RAM / NVIDIA L4 (24GB) x1
MACHINE_TYPE=g2-standard-8
# true: Spot (大幅に安いが途中で止められることがある) / false: 通常料金
SPOT=true
DISK_SIZE_GB=100
# 空なら Deep Learning VM (CUDA 入り Ubuntu 22.04) の最新イメージファミリーを自動で選ぶ
IMAGE_FAMILY=
IMAGE_PROJECT=deeplearning-platform-release
ACESTEP_REPO=https://github.com/ACE-Step/ACE-Step-1.5.git
# 生成が終わったら VM を自動停止する (GPU の課金を止める)
AUTO_SHUTDOWN=true
