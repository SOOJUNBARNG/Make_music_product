# infra/gcp.sh の設定。環境変数で個別に上書きもできる (例: ZONE=asia-northeast1-a infra/gcp.sh quota)

PROJECT=jpix-it
ZONE=us-central1-a
VM_NAME=makemusic-l4
# g2-standard-8 = 8 vCPU / 32GB RAM / NVIDIA L4 (24GB) x1
MACHINE_TYPE=g2-standard-8
# true: Spot (大幅に安いが途中で止められることがある) / false: 通常料金
SPOT=true
DISK_SIZE_GB=100
# 空なら Deep Learning VM (CUDA 入り Ubuntu 22.04) の最新イメージファミリーを自動で選ぶ
IMAGE_FAMILY=
IMAGE_PROJECT=deeplearning-platform-release
ACESTEP_REPO=https://github.com/ACE-Step/ACE-Step-1.5.git
# 生成が終わったら VM を自動停止する (GPU の課金を止める)
AUTO_SHUTDOWN=true
